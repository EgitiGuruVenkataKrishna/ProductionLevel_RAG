# Legal RAG Assistant — Environment Variables

# Required: Groq API key for LLM generation
GROQ_API_KEY=your_groq_api_key_here

# Set this to "true" to use local ONNX-based embedding/reranking models instead of HuggingFace API.
# Note: Requires `pip install fastembed` (approx. 30MB, downloads models on first use).
# Vercel serverless functions have a 1024MB memory limit, so this is best for Docker/local.
USE_LOCAL_MODELS="false"

# Set this to "true" to use the SQLite DB for chunk metadata instead of loading the massive JSON into memory.
# Note: You MUST run `python scripts/migrate_metadata_to_db.py` first!
USE_SQLITE_METADATA="false"

# Set this to "true" to use the new LangGraph-based Agentic CRAG pipeline.
USE_AGENTIC_PIPELINE="false"

# Optional: HuggingFace token for higher API limits (free models work without it)
HF_API_TOKEN=
